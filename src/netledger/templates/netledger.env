# NetLedger secrets - loaded automatically from the folder that holds netledger.yaml.
# Keep this file private (chmod 600 / restricted ACL) and never commit it.
# Values already set in the real environment take precedence.

# Device credentials (credential set "default")
# NETLEDGER_USERNAME=netbackup
# NETLEDGER_PASSWORD=change-me
# NETLEDGER_ENABLE=

# Git hosting token with write access to the backup repository
#   GitHub fine-grained token: Repository access -> your repo, Permissions -> Contents: Read and write
# GIT_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Optional integrations
# NETBOX_TOKEN=
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# SMTP_PASSWORD=
# PAGERDUTY_ROUTING_KEY=
# NETLEDGER_UI_PASSWORD=
# NETLEDGER_API_TOKEN=
