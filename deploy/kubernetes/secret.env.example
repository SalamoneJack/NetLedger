# Copy to secret.env (git-ignored) and fill in. Becomes the netledger-secrets Secret.
# Prefer an external secret manager (External Secrets, Sealed Secrets, Vault) in production.
NETLEDGER_USERNAME=netbackup
NETLEDGER_PASSWORD=change-me
NETLEDGER_ENABLE=
GIT_TOKEN=github_pat_change_me
SLACK_WEBHOOK_URL=
